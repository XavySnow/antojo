{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "required": [
        "imageRegistry",
        "imageTag"
      ],
      "properties": {
        "imageTag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$",
          "not": {
            "enum": [
              "latest"
            ]
          }
        },
        "imageRegistry": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "enabled",
          "replicas",
          "image",
          "resources",
          "env"
        ],
        "properties": {
          "image": {
            "type": "object",
            "properties": {
              "tag": {
                "anyOf": [
                  {
                    "enum": [
                      ""
                    ]
                  },
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$",
                    "not": {
                      "enum": [
                        "latest"
                      ]
                    }
                  }
                ]
              }
            }
          },
          "replicas": {
            "type": "integer",
            "minimum": 1
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "tag": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*(?:@sha256:[a-f0-9]{64})?$",
              "not": {
                "enum": [
                  "latest"
                ]
              }
            }
          }
        }
      }
    }
  }
}
